# =============================
# GovAssist AI — Root .gitignore
# =============================
# Keep committed repo clean: env/secrets, dependencies,
# generated bytecode/build artifacts, IDE/editor metadata,
# OS junk, and logs should never be pushed.

# ---------------------------------------------------------------------------
# 1. ENVIRONMENT / SECRETS  (CRITICAL — NEVER COMMIT REAL KEYS)
# ---------------------------------------------------------------------------
.env
.env.local
.env.production
.env.staging
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example templates so new devs can copy them:
!.env.example

# ---------------------------------------------------------------------------
# 2. OPERATING SYSTEM JUNK
# ---------------------------------------------------------------------------
# macOS / Linux:
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd
volumeicon.db

# Windows:
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# 3. PYTHON (BACKEND)
# ---------------------------------------------------------------------------
# Bytecode / compiled:
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.egg
*.egg-info/
dist/
build/
*.egg-info/
.installed.cfg
eggs/
parts/
sdist/
var/
wheels/
*.whl

# Virtual environments — pick any name the team might use:
venv/
venv.ps1/
ENV/
env/
.venv/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/

# Python profilers / coverage:
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
nosetests.xml
coverage.json
.perf
*.prof

# ---------------------------------------------------------------------------
# 4. NODE / NEXT.JS (FRONTEND) — duplicates frontend/.gitignore so the
#    rules still apply even when the repo root is the only git root.
# ---------------------------------------------------------------------------
frontend/node_modules/
node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.data.*
.yarn/cache
.yarn/install-state.gz
.yarn/metadata
.yarn/releases
.yarn/plugins
.yarn/versions
.yarn/sdks
.yarnrc.yml

frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo
frontend/.vercel/
frontend/next-env.d.ts
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------------------
# 5. LOGS & DEBUG
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt
pip-delete-this-directory.txt
*.trace

# ---------------------------------------------------------------------------
# 6. EDITORS / IDEs
# ---------------------------------------------------------------------------
# VS Code:
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# JetBrains (PyCharm, WebStorm, IntelliJ):
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# Sublime / Vim / Emacs:
*.sublime-workspace
*.sublime-project
Session.vim
.netrwhist
*~

# ---------------------------------------------------------------------------
# 7. DEPLOYMENT / DOCKER
# ---------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.dev.yml
docker-compose.local.yml
*.docker.local
.k8s.local/
helm/values.local.yaml
terraform.tfstate
terraform.tfstate.backup
*.tfvars
.terraform/

# ---------------------------------------------------------------------------
# 8. OTHER
# ---------------------------------------------------------------------------
# Temporary files:
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
.tmp/
.temp/

# Local-only lock overrides (keep the canonical ones committed):
# NOTE: If you WANT to commit package-lock.json/requirements.lock,
# this section intentionally does NOT ignore them. They stay tracked.

# ---------------------------------------------------------------------------
# 9. LINT / TEMPORARY PROJECT ARTIFACTS
# ---------------------------------------------------------------------------
frontend/lint-results.txt
lint-results.txt
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---------------------------------------------------------------------------
# 10. SERVICE ACCOUNT KEYS / CLOUD CREDENTIALS (CRITICAL — NEVER COMMIT)
# ---------------------------------------------------------------------------
# Google Cloud / Firebase service account keys:
service-account*.json
google-credentials*.json
gcloud-credentials*.json
firebase-adminsdk*.json
# Any JSON file that clearly contains credentials:
*credentials*.json
*keys.json
*.serviceaccount.json

# AWS:
.aws/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# ---------------------------------------------------------------------------
# 11. DATABASE / DATA FILES (KEEP LOCAL ONLY)
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
data/
database/data/
database/files/
uploads/
documents/
storage/
tmp/
temp/

# ---------------------------------------------------------------------------
# 12. ADDITIONAL ENVIRONMENT FILES (DEEP MATCH)
# ---------------------------------------------------------------------------
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
.env.*.local


# GovAssist AI — .gitattributes
# Normalize line endings and mark file types so git behaves consistently
# across Windows, macOS, and Linux.

# ---- Text normalization ----
* text=auto eol=lf

# ---- Source files (force LF, never CRLF) ----
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.py       text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.md       text eol=lf
*.html     text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.conf     text eol=lf
*.env      text eol=lf
*.env.*    text eol=lf
Dockerfile text eol=lf
*.sh       text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ---- Lock files (treat as binary to avoid merge conflicts) ----
package-lock.json  binary
yarn.lock          binary
pnpm-lock.yaml     binary
poetry.lock        binary
Pipfile.lock       binary

# ---- Binary files (never diff, never normalize) ----
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.svg      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.otf      binary
*.pdf      binary
*.zip      binary
*.tar.gz   binary
*.7z       binary
*.pyd      binary
*.dll      binary
*.so       binary
*.dylib    binary

# ---- Document / certificate files (private, treat as binary) ----
*.doc      binary
*.docx     binary
*.xls      binary
*.xlsx     binary
*.ppt      binary
*.pptx     binary
*.pem      binary
*.key      binary
*.crt      binary
*.cer      binary
*.p12      binary
*.pfx      binary
*.sqlite   binary
*.sqlite3  binary
*.db       binary

# ---- Files that should never appear in release archives ----
.github/              export-ignore
.gitignore            export-ignore
.gitattributes        export-ignore
.vscode/              export-ignore
.idea/                export-ignore
*.log                 export-ignore
lint-results.txt      export-ignore

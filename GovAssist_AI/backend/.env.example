# Backend — GovAssist AI
# Copy this file to `.env` and fill in your real secrets. NEVER commit `.env`.

# ---------- MongoDB ----------
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=govassist

# ---------- LLM (Groq / Llama 3 via LangChain) ----------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ---------- Document Storage (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- Google Cloud OCR (Vision API) — optional ----------
# Set path to your service account key JSON file (do NOT commit this file):
GOOGLE_APPLICATION_CREDENTIALS=./path/to/your-service-account-key.json

# ---------- Clerk (Citizen Auth) — sync with frontend/.env.local ----------
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ---------- Admin JWT (GovAssist self-issued) ----------
# SECRET_KEY: Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- Default Admin Account ----------
# DEFAULT_ADMIN_PASSWORD: Must be set in .env for the default admin to be seeded.
DEFAULT_ADMIN_EMAIL=admin@govassist.ai
DEFAULT_ADMIN_PASSWORD=change-this-to-a-strong-admin-password
DEFAULT_ADMIN_NAME=System Administrator

# ---------- URLs ----------
FRONTEND_URL=http://localhost:3000
# API runs on:
#   uvicorn main:app --reload --port 8000
ENVIRONMENT=development
